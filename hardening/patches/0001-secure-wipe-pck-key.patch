+// Hardening: zero memory in a way the optimizer may not elide (unlike memset).
+static void _secure_zero(void *p_mem, size_t p_size) {
+	volatile uint8_t *vp = static_cast<volatile uint8_t *>(p_mem);
+	while (p_size--) {
+		*vp++ = 0;
+	}
+}
